{
  "name": "ITON: Nociceptor Study",
  "description": "Stage 3 ITON: tissue forms daemons tracking input, output learns to reconstruct, nociceptor fires on error.",
  "config": {
    "description": "ITON nociceptor experiment. Tissue forms daemons driven by input. Output learns to reconstruct input pattern. Nociceptor fires on reconstruction error.",
    "regions": [
      {
        "id": "input",
        "grid": { "width": 20, "height": 20 },
        "source": {
          "type": "ascii",
          "text": "TL",
          "frames_per_char": 15,
          "noise": { "background": 0.05, "shift": false, "inter_char": false }
        }
      },
      {
        "id": "tissue",
        "grid": { "width": 50, "height": 50 },
        "wiring": {
          "deamon": {
            "shape": "square",
            "fixed": true,
            "excitatory": { "offset": 1, "noise": 0, "weights": [1] },
            "inhibitory": {
              "offset": 6,
              "noise": 0,
              "sectors": 12,
              "weights": [1]
            }
          },
          "dendrite_exc_weight": 0.9,
          "dendrite_inh_weight": -1.0,
          "process_mode": "group_avg",
          "tension_function": { "x": 1, "x_pow_3": 12 }
        }
      },
      {
        "id": "output",
        "grid": { "width": 40, "height": 20 },
        "wiring": {
          "deamon": {
            "shape": "square",
            "excitatory": { "offset": 1, "noise": 0.5, "weights": [1, 1, 1] },
            "inhibitory": {
              "offset": 3,
              "noise": 0.5,
              "sectors": 12,
              "weights": [1, 1, 1, 1, 1, 1]
            }
          },
          "dendrite_exc_weight": 0.65,
          "dendrite_inh_weight": -0.92,
          "process_mode": "group_avg",
          "tension_function": { "x": 1, "x_pow_3": 20, "x_pow_2": 3 }
        }
      },
      {
        "id": "nociceptor",
        "grid": { "width": 1, "height": 2 },
        "source": { "type": "error_diff", "target": "label", "diff_mode": "abs" }
      }
    ],
    "connections": [
      {
        "from": "input",
        "to": "tissue",
        "type": "full",
        "weight": 0.15,
        "density": 0.4,
        "learning": { "rate": 0.05 }
      },
      {
        "from": "tissue",
        "to": "output",
        "type": "full",
        "weight": 0.65,
        "density": 0.4,
        "learning": { "rate": 0.002 }
      },
      {
        "from": "nociceptor",
        "to": "output",
        "type": "full",
        "weight": 0,
        "density": 0.3,
        "learning": { "rate": 0 }
      }
    ]
  }
}
