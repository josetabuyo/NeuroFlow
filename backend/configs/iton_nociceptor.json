{
  "name": "ITON: Nociceptor Study",
  "description": "Stage 3 ITON: tissue forms daemons tracking input, two independent output+nociceptor channels (L and T), each with its own nerve.",
  "config": {
    "handler": "ITON_Nociceptor_Study",
    "description": "ITON nociceptor experiment. Tissue forms daemons driven by input. Two output neurons (output_L, output_T) each learn independently via their own nerve from a dedicated nociceptor.",
    "regions": [
      {
        "id": "input",
        "grid": {
          "width": 20,
          "height": 20
        },
        "source": {
          "type": "ascii",
          "text": "TL",
          "frames_per_char": 15,
          "noise": {
            "background": 0.05,
            "shift": false,
            "inter_char": false
          }
        }
      },
      {
        "id": "tissue",
        "grid": {
          "width": 50,
          "height": 50
        },
        "tension": {
          "function": {
            "x": 1,
            "x_pow_3": 12
          }
        },
        "process_mode": "group_avg"
      },
      {
        "id": "output_L",
        "grid": {
          "width": 1,
          "height": 1
        },
        "handler_method": "label_L",
        "tension": {
          "function": {
            "x": 1,
            "x_pow_3": 20,
            "x_pow_2": 3
          }
        },
        "process_mode": "group_avg"
      },
      {
        "id": "output_T",
        "grid": {
          "width": 1,
          "height": 1
        },
        "handler_method": "label_T",
        "tension": {
          "function": {
            "x": 1,
            "x_pow_3": 20,
            "x_pow_2": 3
          }
        },
        "process_mode": "group_avg"
      },
      {
        "id": "nociceptor_L",
        "grid": {
          "width": 1,
          "height": 1
        },
        "source": {
          "type": "label_mismatch",
          "char_region": "input",
          "label_region": "output_L"
        },
        "target": "output_L"
      },
      {
        "id": "nociceptor_T",
        "grid": {
          "width": 1,
          "height": 1
        },
        "source": {
          "type": "label_mismatch",
          "char_region": "input",
          "label_region": "output_T"
        },
        "target": "output_T"
      }
    ],
    "connections": [
      {
        "on": "tissue",
        "deamon": {
          "shape": "square",
          "fixed": true,
          "excitatory": {
            "weight": 0.9,
            "offset": 1,
            "noise": 0,
            "weights": [1]
          },
          "inhibitory": {
            "weight": -1.0,
            "offset": 6,
            "noise": 0,
            "sectors": 12,
            "weights": [1]
          }
        }
      },
      {
        "on": "output_L",
        "deamon": {
          "shape": "square",
          "excitatory": {
            "weight": 0.65,
            "offset": 1,
            "noise": 0.0,
            "weights": [1]
          },
          "inhibitory": {
            "weight": -1.0,
            "offset": 1,
            "noise": 0.0,
            "weights": [1]
          }
        }
      },
      {
        "on": "output_T",
        "deamon": {
          "shape": "square",
          "excitatory": {
            "weight": 0.65,
            "offset": 1,
            "noise": 0.0,
            "weights": [1]
          },
          "inhibitory": {
            "weight": -1.0,
            "offset": 1,
            "noise": 0.0,
            "weights": [1]
          }
        }
      },
      {
        "from": "input",
        "to": "tissue",
        "full": {
          "weight": 0.15,
          "density": 0.4,
          "learning": { "rate": 0.05 }
        }
      },
      {
        "on": "tissue",
        "nerve": {
          "insertion": {"x": 14, "y": 14},
          "radius": 6,
          "from": {
            "region": "nociceptor_L",
            "density": 0.5,
            "weight": -0.005
          },
          "to": {
            "region": "output_L",
            "density": 0.02,
            "weight": 0.65,
            "learning": { "rate": 0.002 }
          }
        }
      },
      {
        "on": "tissue",
        "nerve": {
          "insertion": {"x": 36, "y": 36},
          "radius": 6,
          "from": {
            "region": "nociceptor_T",
            "density": 0.5,
            "weight": -0.005
          },
          "to": {
            "region": "output_T",
            "density": 0.02,
            "weight": 0.65,
            "learning": { "rate": 0.002 }
          }
        }
      }
    ]
  }
}
