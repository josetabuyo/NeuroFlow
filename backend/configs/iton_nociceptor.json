{
  "name": "ITON: Nociceptor Study",
  "description": "Stage 3 ITON: tissue forms daemons tracking input, output learns to reconstruct, nociceptor fires on error. Nerve bundles connect nociceptor and output through tissue.",
  "config": {
    "description": "ITON nociceptor experiment. Tissue forms daemons driven by input. Output learns to reconstruct input pattern. Nociceptor fires on reconstruction error. Paired nerves: one circle per output neuron, adjacently placed on tissue.",
    "regions": [
      {
        "id": "input",
        "grid": {
          "width": 20,
          "height": 20
        },
        "source": {
          "type": "ascii",
          "text": "TL",
          "frames_per_char": 15,
          "noise": {
            "background": 0.05,
            "shift": false,
            "inter_char": false
          }
        }
      },
      {
        "id": "tissue",
        "grid": {
          "width": 50,
          "height": 50
        },
        "tension": {
          "function": {
            "x": 1,
            "x_pow_3": 12
          }
        },
        "process_mode": "group_avg"
      },
      {
        "id": "output",
        "grid": {
          "width": 1,
          "height": 2
        },
        "neuron_labels": [["L"], ["T"]],
        "tension": {
          "function": {
            "x": 1,
            "x_pow_3": 20,
            "x_pow_2": 3
          }
        },
        "process_mode": "group_avg"
      },
      {
        "id": "nociceptor",
        "grid": {
          "width": 1,
          "height": 2
        },
        "source": {
          "type": "label_mismatch",
          "char_region": "input",
          "label_region": "output"
        }
      }
    ],
    "connections": [
      {
        "on": "tissue",
        "deamon": {
          "shape": "square",
          "fixed": true,
          "excitatory": {
            "weight": 0.9,
            "offset": 1,
            "noise": 0,
            "weights": [1]
          },
          "inhibitory": {
            "weight": -1.0,
            "offset": 6,
            "noise": 0,
            "sectors": 12,
            "weights": [1]
          }
        }
      },
      {
        "on": "output",
        "deamon": {
          "shape": "square",
          "excitatory": {
            "weight": 0.65,
            "offset": 1,
            "noise": 0.0,
            "weights": [1]
          },
          "inhibitory": {
            "weight": -1.0,
            "offset": 1,
            "noise": 0.0,
            "weights": [1]
          }
        }
      },
      {
        "from": "input",
        "to": "tissue",
        "full": {
          "weight": 0.15,
          "density": 0.4,
          "learning": { "rate": 0.05 }
        }
      },
      {
        "on": "tissue",
        "nerve": {
          "insertion": "random",
          "paired": true,
          "radius": 6,
          "from": {
            "region": "nociceptor",
            "density": 0.5,
            "weight": -0.005
          },
          "to": {
            "region": "output",
            "density": 0.02,
            "weight": 0.65,
            "learning": { "rate": 0.002 }
          }
        }
      }
    ]
  }
}
