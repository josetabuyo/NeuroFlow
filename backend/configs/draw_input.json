      {
        "id": "input",
        "grid": { "width": 15, "height": 15 },
        "source": {
          "type": "draw",
          "noise": { "background": 0.9 }
        }
      }
    ],
    "connections": [
      {
        "from": "input",
        "to": "tissue",
        "type": "full",
        "weight": 0.3,
        "learning_rate": 1.0
